# Example only; this file is not loaded automatically. Export variables in your
# shell or inject them using your OS credential manager / service environment.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=reports@example.com
SMTP_USER=reports@example.com
SMTP_PASSWORD=replace-with-an-app-password
# Use ssl with port 465 if required by your provider. Plaintext SMTP is not supported.
# Optional unique installation identifier used in report Message-ID headers:
ROBLOXSTATS_REPORT_ID=my-desktop

# Alternative: Resend API. Replace re_xxxxxxxxx with your real API key locally.
# Selecting Resend bypasses Gmail SMTP/Keychain configuration.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=onboarding@resend.dev
